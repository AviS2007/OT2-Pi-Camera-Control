[Unit]
Description=OT-2 dual Pi camera stream/record server
After=network-online.target
Wants=network-online.target

[Service]
# OT2CAM_USER is substituted by install.sh
User=__USER__
Environment=PYTHONUNBUFFERED=1
# --rotate180 1 : camera 1 (Module 3 Wide on the CAM/DISP 0 connector) is mounted upside down
ExecStart=/usr/bin/python3 /opt/ot2cam/camserver.py --port 8080 --size 1280x720 --fps 30 --outdir /home/__USER__/recordings --rotate180 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
