[Unit]
Description=OT-2 dual Pi camera stream/record server
After=network-online.target
Wants=network-online.target

[Service]
# OT2CAM_USER is substituted by install.sh
User=__USER__
Environment=PYTHONUNBUFFERED=1
# --rotate180 0,1 : both cameras are mounted upside down on the OT-2
# --profile 720p  : cool default (no fan). The page's 1080p button switches live; the Pi throttles there.
ExecStart=/usr/bin/python3 /opt/ot2cam/camserver.py --port 8080 --profile 720p --fps 30 --outdir /home/__USER__/recordings --rotate180 0,1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
