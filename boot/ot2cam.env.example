# Copied to the SD card as ot2cam/ot2cam.env by pc/prepare_sd.ps1 (which fills it from its parameters).
# Every line is optional. The file is deleted from the card after first boot.

# Create this login if it does not exist yet (leave blank to keep the card's existing user)
PI_USER=
PI_PASSWORD=

# Hostname for the Pi (reachable as <HOSTNAME_NEW>.local over the USB link)
HOSTNAME_NEW=ot2-cam-pi

# Ordinary WPA2 Wi-Fi (lab router or a phone hotspot)
WIFI_SSID=
WIFI_PSK=
WIFI_COUNTRY=CA

# eduroam (WPA2-Enterprise, PEAP/MSCHAPv2). Note eduroam blocks PC<->Pi traffic; pair it with Tailscale.
EDUROAM_ID=
EDUROAM_PASSWORD=

# Tailscale auth key from https://login.tailscale.com/admin/settings/keys (lets the PC reach the Pi anywhere)
TAILSCALE_AUTHKEY=

# Fallback hotspot the Pi itself broadcasts when none of the networks above is in range.
# Join it from a laptop: Pi is 10.56.0.1 (http://10.56.0.1:8080/, ssh ot2@10.56.0.1). Blank = disabled.
HOTSPOT_SSID=OT2-Cam-Pi
HOTSPOT_PSK=ot2camera
